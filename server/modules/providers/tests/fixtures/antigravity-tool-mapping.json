{
  "_comment": "Shared fixture for the Antigravity tool mapping. Each case is one agy tool call: the arguments exactly as transcript.jsonl stores them (every value a JSON literal string), the result text that call produced, and the canonical shape the frontend registry must be able to read. The backend asserts the mapper's output equals `expected`; the frontend asserts each registry getter returns a non-empty value for `expected.input`. Keep the two in sync — the point of the fixture is that a rename nobody reads counts as a failure.",
  "cases": [
    {
      "agyName": "view_file",
      "args": {
        "AbsolutePath": "\"C:/Users/shaojiaxing/.gemini/config/skills/playwright-cli/SKILL.md\"",
        "toolAction": "\"Viewing playwright skill\"",
        "toolSummary": "\"View playwright-cli skill\""
      },
      "resultContent": "Created At: 2026-09-29T09:11:05+08:00\nCompleted At: 2026-09-29T09:11:05+08:00\nFile Path: `file:///C:/Users/shaojiaxing/.gemini/config/skills/playwright-cli/SKILL.md`\nTotal Lines: 433\n1: ---",
      "expected": {
        "toolName": "Read",
        "input": {
          "file_path": "C:/Users/shaojiaxing/.gemini/config/skills/playwright-cli/SKILL.md"
        }
      },
      "mustRender": ["file_path"]
    },
    {
      "_note": "Backslash-separated path: the diff-card titles split on '/' so both separators must normalize to one.",
      "agyName": "view_file",
      "args": {
        "AbsolutePath": "\"C:\\\\Users\\\\shaojiaxing\\\\docs\\\\a.md\"",
        "toolAction": "\"Viewing\""
      },
      "resultContent": null,
      "expected": {
        "toolName": "Read",
        "input": { "file_path": "C:/Users/shaojiaxing/docs/a.md" }
      },
      "mustRender": ["file_path"]
    },
    {
      "agyName": "run_command",
      "args": {
        "CommandLine": "\"npm run build\"",
        "Cwd": "\"/tmp\"",
        "IsDaemon": "\"false\"",
        "WaitMsBeforeAsync": "\"5000\"",
        "toolAction": "\"Building\"",
        "toolSummary": "\"Build the project\""
      },
      "resultContent": "build ok",
      "expected": {
        "toolName": "Bash",
        "input": { "command": "npm run build", "description": "Build the project" }
      },
      "mustRender": ["command"]
    },
    {
      "_note": "Not declared as a daemon but timed out into the background — the majority case. The badge rides in description because Bash reads only command and description and hides its result on success.",
      "agyName": "run_command",
      "args": {
        "CommandLine": "\"dotnet run --project src/Signage.Api\"",
        "IsDaemon": "\"false\"",
        "toolAction": "\"Starting dev server\"",
        "toolSummary": "\"Start Signage.Api server\""
      },
      "resultContent": "Created At: 2026-09-29T09:13:29+08:00\nTool is running as a background task with task id: ee37e759-6299-4424-921f-8dbbcc49e2ff/task-72\nTask Description: dotnet run\nYOU MUST TAKE ONE OF THE FOLLOWING TWO ACTIONS:",
      "expected": {
        "toolName": "Bash",
        "input": {
          "command": "dotnet run --project src/Signage.Api",
          "description": "[background · task-72] Start Signage.Api server"
        }
      },
      "mustRender": ["command"]
    },
    {
      "_note": "Declared daemon. 'false' must not be truthy — IsDaemon is the string \"false\" in every real record.",
      "agyName": "run_command",
      "args": { "CommandLine": "\"dotnet run\"", "IsDaemon": "\"true\"", "toolSummary": "\"Start server\"" },
      "resultContent": null,
      "expected": {
        "toolName": "Bash",
        "input": { "command": "dotnet run", "description": "[background] Start server" }
      },
      "mustRender": ["command"]
    },
    {
      "agyName": "replace_file_content",
      "args": {
        "AllowMultiple": "\"false\"",
        "Description": "\"Use installed Chrome channel\"",
        "EndLine": "\"15\"",
        "Instruction": "\"Use chrome channel\"",
        "ReplacementContent": "\"const b = await chromium.launch({ channel: 'chrome' });\"",
        "StartLine": "\"10\"",
        "TargetContent": "\"const b = await chromium.launch();\"",
        "TargetFile": "\"d:/code/qdzn/gb-poc-signage/.scratch/mobile_audit.js\"",
        "toolAction": "\"Updating browser launch config\"",
        "toolSummary": "\"Update browser launch to channel chrome\""
      },
      "resultContent": "Updated.",
      "expected": {
        "toolName": "Edit",
        "input": {
          "file_path": "d:/code/qdzn/gb-poc-signage/.scratch/mobile_audit.js",
          "old_string": "const b = await chromium.launch();",
          "new_string": "const b = await chromium.launch({ channel: 'chrome' });"
        }
      },
      "mustRender": ["file_path", "old_string", "new_string"]
    },
